# Copy this file to android/keystore.properties and fill in your values.
# DO NOT commit keystore.properties or the .keystore file to git.
#
# To generate a keystore (one-time, keep forever — losing it means you cannot
# update the app on Google Play):
#
#   keytool -genkey -v -keystore C:\path\to\jobswipe.keystore \
#           -alias jobswipe -keyalg RSA -keysize 2048 -validity 10000
#
# Use the same passwords for both store and key (simpler).

storeFile=C:/path/to/your/jobswipe.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=jobswipe
keyPassword=YOUR_KEY_PASSWORD
