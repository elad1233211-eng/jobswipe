{
  "name": "jobswipe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "gen-vapid": "tsx scripts/gen-vapid.ts",
    "gen-icons": "tsx scripts/gen-icons.ts",
    "gen-screenshots": "tsx scripts/capture-screenshots.ts",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\" && npm run seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && npx cap open android",
    "android:debug": "npx cap sync android && tsx scripts/android-build.ts assembleDebug",
    "android:release": "npx cap sync android && tsx scripts/android-build.ts bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@sentry/nextjs": "^10.50.0",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "next": "16.2.4",
    "nodemailer": "^8.0.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
